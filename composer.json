{
  "name": "loki1913/agent-system",
  "description": "A modular personal AI-agent workspace built with Neuron AI and OpenRouter.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "vlucas/phpdotenv": "^5.6",
    "neuron-core/neuron-ai": "^4.1",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "AgentSystem\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t public",
    "check": "php -l public/index.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
