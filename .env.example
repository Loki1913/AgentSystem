# Copy to .env. Never commit real secrets.
APP_ENV=local
APP_URL=http://127.0.0.1:8080
APP_DEBUG=false

# OpenRouter: create a key in https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Set a model ID that is currently available to your OpenRouter account.
# Free model availability/quotas can change; keep this configurable.
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8080
OPENROUTER_APP_TITLE=AgentSystem
OPENROUTER_TIMEOUT=60

# Optional model override for image and browser-screenshot analysis.
# Must be a multimodal model available in your OpenRouter account.
OPENROUTER_VISION_MODEL=
AGENT_MAX_TOKENS=2500

# Optional Playwright worker (keep it local; never expose publicly).
BROWSER_WORKER_URL=http://127.0.0.1:8091
BROWSER_WORKER_TOKEN=
